body {
  font-family: Verdana, sans-serif;
  max-width: 480px;
  margin: 0 auto;
  padding: 20px;
  background-color: #fff8f0;
}

h1 {
  color: #e65100;
  text-align: center;
  font-size: 24px;
}

.intro {
  text-align: center;
  color: #555;
}

label {
  font-weight: bold;
  display: block;
  margin-bottom: 6px;
}

input {
  width: 100%;
  padding: 12px;
  font-size: 16px;
  box-sizing: border-box;
  margin-bottom: 12px;
  border: 2px solid #e65100;
  border-radius: 10px;
}

button {
  width: 100%;
  padding: 14px;
  font-size: 16px;
  font-weight: bold;
  background-color: #e65100;
  color: white;
  border: none;
  border-radius: 10px;
}

ul {
  list-style: none;
  padding: 0;
}

li {
  background: white;
  padding: 14px;
  margin-top: 10px;
  border-left: 6px solid #e65100;
  border-radius: 8px;
}

footer {
  text-align: center;
  margin-top: 30px;
  font-size: 12px;
  color: #888;
}
